generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── ユーザー ────────────────────────────────────────────────
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  fullName  String?
  company   String?
  jobTitle  String?
  bio       String?
  industry  String?
  employeeCount Int?
  recentRevenue      String?  // 直近確定期の売上レンジ
  fiscalMonth        Int?     // 決算月 (1-12)
  targetRevenueScale String?  // メイン商材のターゲット売上規模
  marketingChannels  Json     @default("[]")  // 使用中マーケチャネル (string[])
  foundingYear       Int?     // 設立年
  fullTimeEmployees  String?  // 正社員数
  branchCount        String?  // 拠点数
  operatingMargin    String?  // 営業利益率
  serviceUnitPrice   String?  // サービス平均単価
  serviceBreakdown   Json     @default("[]")  // 売上構成比 [{name,percentage}]
  customerCount      String?  // 顧客数
  revenueGrowth      String?  // 3年前からの売上成長率
  revenueTarget3y    String?  // 3年後の売上目標
  googleId  String?  @unique
  image     String?
  role      Role     @default(guest)
  referralTemplate String?
  snsLinks  Json     @default("{}")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdEvents     CommunityEvent[]
  sentFeedbacks     Feedback[]        @relation("SentFeedbacks")
  receivedFeedbacks Feedback[]        @relation("ReceivedFeedbacks")
  referralLinks     ReferralLink[]
  invitedEvents     EventInvitee[]
  feedbackComments  FeedbackComment[]
  issueSubmissions  IssueSubmission[]

  @@map("users")
}

enum Role {
  admin
  member
  guest

  @@map("role")
}

// ─── 交流会イベント ──────────────────────────────────────────
model CommunityEvent {
  id          String    @id @default(cuid())
  title       String
  heldAt      DateTime
  location    String?
  description String?
  minutesText String?
  aiSummary   String?
  issuePdfData String?  // 経営課題PDF (base64)
  issuePdfName String?  // 元ファイル名
  createdBy   String
  creator     User      @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  feedbacks Feedback[]
  invitees  EventInvitee[]
  issueSubmissions IssueSubmission[]

  @@map("community_events")
}

// ─── 交流会の招待者 ─────────────────────────────────────────
model EventInvitee {
  eventId   String
  userId    String
  event     CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@id([eventId, userId])
  @@map("event_invitees")
}

// ─── フィードバック / 紹介 ───────────────────────────────────
model Feedback {
  id         String         @id @default(cuid())
  fromUserId String
  fromUser   User           @relation("SentFeedbacks", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User           @relation("ReceivedFeedbacks", fields: [toUserId], references: [id], onDelete: Cascade)
  eventId    String?
  event      CommunityEvent? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type       FeedbackType
  content    String
  linkToken  String?
  createdAt  DateTime       @default(now())

  comments   FeedbackComment[]

  @@map("feedbacks")
}

// ─── おせっかいへのコメント ──────────────────────────────────
model FeedbackComment {
  id         String   @id @default(cuid())
  feedbackId String
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content    String
  createdAt  DateTime @default(now())

  @@index([feedbackId])
  @@map("feedback_comments")
}

enum FeedbackType {
  intro
  feedback
  advice
  other

  @@map("feedback_type")
}

// ─── 経営課題の提出（1ユーザー×1イベントで1提出、編集で上書き） ──
model IssueSubmission {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId    String
  event      CommunityEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  mode       IssueMode       // text | qa
  sourceText String?         // ①テキスト形式の元入力
  qaAnswers  Json?           // ②質疑応答形式の回答 [{q,a}]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  issues     ManagementIssue[]

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
  @@map("issue_submissions")
}

// ─── 個々の経営課題（1提出につき2〜3件） ──────────────────────
model ManagementIssue {
  id           String          @id @default(cuid())
  submissionId String
  submission   IssueSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  category     String          // 課題カテゴリ
  requestType  String?         // 相談種別（ヒアリング / 依頼）
  hotTopic     String?         // （旧）ホットトピック ※現UIでは未使用
  summary      String          // 見出し（質問・依頼の一文）
  detail       String?         // 背景・具体的に聞きたいこと/紹介してほしいこと
  orderIndex   Int             @default(0)

  @@index([submissionId])
  @@map("management_issues")
}

enum IssueMode {
  text
  qa
  manual

  @@map("issue_mode")
}

// ─── 紹介リンク ─────────────────────────────────────────────
model ReferralLink {
  id         String    @id @default(cuid())
  fromUserId String
  fromUser   User      @relation(fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  message    String?
  token      String    @unique @default(cuid())
  expiresAt  DateTime?
  clickCount Int       @default(0)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())

  @@map("referral_links")
}
